# Copy this file to `.env` in the project root and fill in the keys you use.
# `.env` is gitignored; never commit real keys.
#
# Default draft/critic provider (DeepSeek V4.1 Flash).
DEEPSEEK_API_KEY=
#
# Quality tier used by the brief/glossary/judge prompts
# (`configs/models/deepseek.yaml` points that tier at OpenRouter).
OPENROUTER_API_KEY=
#
# Optional TARJOMAN_* overrides (env wins over YAML):
# TARJOMAN_BUDGET__MAX_USD=10
# TARJOMAN_PROVIDER__THINKING=disabled
# TARJOMAN_PIPELINE__ANALYZE__BRIEF_APPROVAL=auto
